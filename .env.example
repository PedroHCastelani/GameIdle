# ============================================================
# THE LIFE — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commitar o .env com valores reais
# ============================================================

# Banco de dados
DATABASE_URL="postgresql://dev:senha@localhost:5433/thelife_dev"
DATABASE_URL_REPLICA="postgresql://dev:senha@localhost:5433/thelife_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# Autenticação (mínimo 32 caracteres cada)
JWT_SECRET="substitua-por-string-aleatoria-de-pelo-menos-32-chars"
COOKIE_SECRET="substitua-por-string-aleatoria-de-pelo-menos-32-chars"

# URLs
FRONTEND_URL="http://localhost:3000"
PORT=3001

# BrasilAPI (validação de CPF — gratuita, sem configuração necessária)
BRASILAPI_URL="https://brasilapi.com.br/api"

# Cloudflare Turnstile (CAPTCHA no registro)
CLOUDFLARE_TURNSTILE_SECRET="substitua-pela-secret-key-do-turnstile"

# Gateway de pagamento (configurar na Fase 1.5+)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# MERCADOPAGO_ACCESS_TOKEN=""
